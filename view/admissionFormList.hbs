<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admission Applications</title>
    <link rel="icon" href="https://i.postimg.cc/Y9kpSNhL/live-chat.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-light: #8b5cf6;
            --secondary: #64748b;
            --surface: #ffffff;
            --surface-hover: #f8fafc;
            --surface-secondary: #f1f5f9;
            --border: #e2e8f0;
            --border-light: #f1f5f9;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-tertiary: #94a3b8;
            --text-muted: #cbd5e1;
            --success: #10b981;
            --success-light: #d1fae5;
            --success-bg: #ecfdf5;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --warning-bg: #fffbeb;
            --danger: #ef4444;
            --danger-light: #fee2e2;
            --danger-bg: #fef2f2;
            --info: #3b82f6;
            --info-light: #dbeafe;
            --info-bg: #eff6ff;
            --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            --radius-xs: 0.25rem;
            --radius-sm: 0.375rem;
            --radius-md: 0.5rem;
            --radius-lg: 0.75rem;
            --radius-xl: 1rem;
            --radius-2xl: 1.5rem;
            --radius-full: 9999px;
            --header-height: 180px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
            font-size: 14px;
        }

        .app-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Compact Header Styles */
        .header-section {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px) saturate(180%);
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
            border-top: none;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            padding: 0.875rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border-bottom: 1px solid var(--border-light);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 0.875rem;
        }

        .back-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-md);
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow-xs);
        }

        .back-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .header-title {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: -0.025em;
        }

        .header-badge {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            font-size: 0.625rem;
            font-weight: 600;
            padding: 0.25rem 0.5rem;
            border-radius: var(--radius-full);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            box-shadow: var(--shadow-xs);
        }

        .header-stats {
            display: flex;
            gap: 0.75rem;
        }

        .stat-item {
            text-align: center;
            padding: 0.5rem 0.75rem;
            background: var(--surface);
            border-radius: var(--radius-md);
            min-width: 60px;
            border: 1px solid var(--border-light);
            box-shadow: var(--shadow-xs);
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .stat-number {
            font-size: 1.125rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: block;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.625rem;
            color: var(--text-tertiary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 0.125rem;
        }

        .filters-section {
            padding: 0.875rem 1.25rem;
            display: flex;
            gap: 0.875rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .search-container {
            position: relative;
            flex: 1;
            min-width: 250px;
        }

        .search-input {
            width: 100%;
            padding: 0.625rem 0.875rem 0.625rem 2.25rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            font-size: 0.8rem;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow-xs);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1), var(--shadow-sm);
            transform: translateY(-1px);
        }

        .search-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-tertiary);
            font-size: 0.875rem;
        }

        .filter-select {
            padding: 0.625rem 0.875rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface);
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-primary);
            min-width: 120px;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-xs);
        }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1), var(--shadow-sm);
        }

        /* Compact Applications Section */
        .applications-section {
            background: var(--surface);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            margin: 1rem;
            margin-top: 0.5rem;
        }

        .applications-header {
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
            flex-shrink: 0;
            background: var(--surface);
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        }

        .applications-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: -0.025em;
        }

        .applications-container {
            flex: 1;
            padding: 1rem;
            background: var(--surface);
            overflow-y: auto;
            max-height: calc(100vh - var(--header-height) - 60px);
            scroll-behavior: smooth;
        }

        .application-list {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
            width: 100%;
            min-height: 300px;
        }

        /* Compact Application Cards */
        .application-card {
            background: var(--surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            padding: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            position: relative;
            width: 100%;
            box-shadow: var(--shadow-xs);
            overflow: hidden;
        }

        .application-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 3px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .application-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary);
        }

        .application-card:hover::before {
            opacity: 1;
        }

        .application-header {
            display: flex;
            align-items: flex-start;
            gap: 0.875rem;
            margin-bottom: 0.875rem;
            width: 100%;
        }

        .application-photo {
            flex-shrink: 0;
            position: relative;
        }

        .photo-img {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-lg);
            object-fit: cover;
            border: 2px solid var(--border-light);
            background: var(--surface-hover);
            display: block;
            box-shadow: var(--shadow-xs);
        }

        .application-info {
            flex: 1;
            min-width: 0;
            width: 100%;
        }

        .application-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.5rem;
            gap: 0.75rem;
            width: 100%;
        }

        .application-name {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex: 1;
            letter-spacing: -0.025em;
        }

        .application-ref {
            font-size: 0.625rem;
            color: var(--text-tertiary);
            font-weight: 600;
            background: var(--surface-secondary);
            padding: 0.25rem 0.5rem;
            border-radius: var(--radius-full);
            white-space: nowrap;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .application-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 0.625rem;
            margin-bottom: 0.875rem;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .detail-item i {
            color: var(--primary);
            flex-shrink: 0;
            width: 14px;
            font-size: 0.875rem;
        }

        .detail-value {
            font-weight: 600;
            color: var(--text-primary);
        }

        .application-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding-top: 0.875rem;
            border-top: 1px solid var(--border-light);
        }

        .application-date {
            font-size: 0.7rem;
            color: var(--text-tertiary);
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-weight: 500;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.375rem 0.75rem;
            border-radius: var(--radius-full);
            font-size: 0.625rem;
            font-weight: 700;
            gap: 0.375rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            box-shadow: var(--shadow-xs);
        }

        .status-pending {
            background: var(--warning-bg);
            color: var(--warning);
            border: 1px solid var(--warning-light);
        }

        .status-approved {
            background: var(--success-bg);
            color: var(--success);
            border: 1px solid var(--success-light);
        }

        .status-rejected {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1px solid var(--danger-light);
        }

        .status-under-review {
            background: var(--info-bg);
            color: var(--info);
            border: 1px solid var(--info-light);
        }

        /* Compact Modal Styles */
        .modal-backdrop {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
        }

        .modal-dialog {
            max-width: 900px;
            margin: 1rem auto;
        }

        .modal-content {
            border: none;
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-xl);
            overflow: hidden;
            background: var(--surface);
        }

        .modal-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            padding: 1.25rem 1.5rem;
            border: none;
            position: relative;
            overflow: hidden;
        }

        .modal-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.3;
        }

        .modal-title {
            font-weight: 800;
            font-size: 1.125rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            position: relative;
            z-index: 1;
            letter-spacing: -0.025em;
        }

        .btn-close {
    opacity: 1;
    position: relative;
    z-index: 1;
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
    filter: none;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23ffffff'%3e%3cpath d='m.293.293.707.707L8 7.293 15.293 1a1 1 0 1 1 1.414 1.414L9.414 9.707 16.707 16a1 1 0 0 1-1.414 1.414L8 10.414 1.707 17.707A1 1 0 0 1 .293 16.293L7.586 9 .293 1.707A1 1 0 0 1 .293.293z'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 0.75em;
}

.btn-close:hover {
    {{!-- opacity: 1; --}}
    {{!-- background: rgba(255, 255, 255, 0.3); --}}
    {{!-- transform: scale(1.1); --}}
}

.btn-close:focus {
    opacity: 1;
    background: rgba(255, 255, 255, 0.3);
    box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.25);
}

        .modal-body {
            padding: 0;
            background: var(--surface-hover);
        }

        /* Compact Detail Sections */
        .detail-section {
            background: var(--surface);
            margin: 1rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-xs);
            border: 1px solid var(--border-light);
            overflow: hidden;
        }

        .section-header {
            background: linear-gradient(135deg, var(--surface-secondary) 0%, var(--surface-hover) 100%);
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
        }

        .section-title {
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: -0.025em;
        }

        .section-title i {
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
            color: white;
            border-radius: var(--radius-sm);
            font-size: 0.75rem;
        }

        .section-content {
            padding: 1.25rem;
        }

        .photo-section {
            text-align: center;
            padding: 1.25rem;
            background: linear-gradient(135deg, var(--surface) 0%, var(--surface-hover) 100%);
        }

        .modal-photo-container {
            position: relative;
            display: inline-block;
            margin-bottom: 1rem;
        }

        .modal-photo {
            width: 100px;
            height: 100px;
            border-radius: var(--radius-xl);
            object-fit: cover;
            border: 3px solid var(--surface);
            box-shadow: var(--shadow-md);
            background: var(--surface-secondary);
        }

        .photo-badge {
            position: absolute;
            bottom: -6px;
            right: -6px;
            width: 28px;
            height: 28px;
            background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.75rem;
            box-shadow: var(--shadow-sm);
            border: 2px solid var(--surface);
        }

        .student-name {
            font-size: 1.125rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 0.375rem;
            letter-spacing: -0.025em;
        }

        .student-ref {
            font-size: 0.75rem;
            color: var(--text-tertiary);
            font-weight: 600;
            background: var(--surface-secondary);
            padding: 0.375rem 0.75rem;
            border-radius: var(--radius-full);
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.875rem;
        }

        .detail-card {
            background: var(--surface-hover);
            border-radius: var(--radius-md);
            padding: 0.875rem;
            border: 1px solid var(--border-light);
            transition: all 0.3s ease;
        }

        .detail-card:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
            border-color: var(--primary);
        }

        .detail-field {
            display: flex;
            flex-direction: column;
            gap: 0.375rem;
        }

        .field-label {
            font-size: 0.625rem;
            font-weight: 700;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }

        .field-label i {
            font-size: 0.625rem;
            color: var(--primary);
        }

        .field-value {
            font-size: 0.8rem;
            color: var(--text-primary);
            font-weight: 600;
            line-height: 1.4;
        }

        .field-value.empty {
            color: var(--text-muted);
            font-style: italic;
            font-weight: 500;
        }

        /* Compact Status Update Section */
        .status-update-section {
            background: linear-gradient(135deg, var(--surface) 0%, var(--surface-hover) 100%);
            margin: 0;
            border-radius: 0;
            border: none;
            border-top: 1px solid var(--border-light);
        }

        .status-update-header {
            background: var(--surface-secondary);
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
        }

        .status-update-content {
            padding: 1.25rem;
        }

        .status-form {
            display: grid;
            grid-template-columns: 1fr 2fr auto;
            gap: 1rem;
            align-items: end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .status-select {
            padding: 0.625rem 0.875rem;
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-primary);
            transition: all 0.3s ease;
            box-shadow: var(--shadow-xs);
        }

        .status-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1), var(--shadow-sm);
        }

        .remarks-input {
            padding: 0.625rem 0.875rem;
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface);
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-primary);
            resize: none;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-xs);
            font-family: inherit;
        }

        .remarks-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1), var(--shadow-sm);
        }

        .remarks-input::placeholder {
            color: var(--text-muted);
            font-weight: 500;
        }

        .update-btn {
            padding: 0.625rem 1.25rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            box-shadow: var(--shadow-sm);
            min-width: 120px;
            justify-content: center;
        }

        .update-btn:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .update-btn:active {
            transform: translateY(0);
        }

        .update-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* Compact Academic Progress */
        .academic-progress {
            display: flex;
            gap: 0.75rem;
            margin-top: 0.875rem;
        }

        .progress-item {
            flex: 1;
            text-align: center;
            padding: 0.75rem;
            background: var(--surface);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-light);
        }

        .progress-value {
            font-size: 1rem;
            font-weight: 800;
            color: var(--primary);
            display: block;
        }

        .progress-label {
            font-size: 0.625rem;
            color: var(--text-tertiary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 0.125rem;
        }

        /* Compact Loading States */
        .infinite-loading {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
            gap: 0.75rem;
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-weight: 600;
            border-top: 1px solid var(--border-light);
            margin-top: 1rem;
            background: var(--surface-hover);
            border-radius: var(--radius-lg);
        }

        .infinite-loading.hidden {
            display: none;
        }

        .loading-spinner {
            width: 18px;
            height: 18px;
            border: 2px solid var(--border);
            border-top: 2px solid var(--primary);
            border-radius: var(--radius-full);
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .end-of-applications {
            text-align: center;
            padding: 1.5rem 1rem;
            color: var(--text-tertiary);
            font-size: 0.8rem;
            font-weight: 600;
            border-top: 1px solid var(--border-light);
            margin-top: 1rem;
            background: var(--surface-hover);
            border-radius: var(--radius-lg);
        }

        .end-of-applications.hidden {
            display: none;
        }

        .end-of-applications i {
            font-size: 1.5rem;
            margin-bottom: 0.75rem;
            color: var(--success);
        }

        /* Compact Loading and Empty States */
        .loading-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2.5rem;
            gap: 0.75rem;
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 2.5rem 1.5rem;
            color: var(--text-secondary);
        }

        .empty-state i {
            font-size: 2.5rem;
            color: var(--text-muted);
            margin-bottom: 1.25rem;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            letter-spacing: -0.025em;
        }

        .empty-state p {
            font-size: 0.875rem;
            color: var(--text-secondary);
            max-width: 400px;
            margin: 0 auto;
            font-weight: 500;
            line-height: 1.5;
        }

        .fade-in {
            animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Compact Skeleton Loading */
        .skeleton-container {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
            width: 100%;
        }

        .skeleton-application {
            background: var(--surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            padding: 1rem;
            display: flex;
            gap: 0.875rem;
            width: 100%;
        }

        .skeleton-photo {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-lg);
            background: linear-gradient(90deg, var(--surface-hover) 25%, var(--border-light) 50%, var(--surface-hover) 75%);
            background-size: 200% 100%;
            animation: shimmer 2s infinite;
            flex-shrink: 0;
        }

        .skeleton-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .skeleton-line {
            height: 10px;
            background: linear-gradient(90deg, var(--surface-hover) 25%, var(--border-light) 50%, var(--surface-hover) 75%);
            background-size: 200% 100%;
            border-radius: var(--radius-xs);
            animation: shimmer 2s infinite;
        }

        .skeleton-line.title { width: 40%; height: 14px; }
        .skeleton-line.subtitle { width: 60%; height: 10px; }
        .skeleton-line.content { width: 80%; height: 10px; }
        .skeleton-line.content-short { width: 55%; height: 10px; }

        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* Compact Scroll Elements */
        .scroll-to-top {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            border: none;
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--shadow-md);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            visibility: hidden;
            z-index: 1000;
        }

        .scroll-to-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .scroll-to-top:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: var(--shadow-lg);
        }

        .scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 3px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
            z-index: 1001;
            transition: width 0.1s ease;
            box-shadow: 0 1px 3px rgba(99, 102, 241, 0.3);
        }

        /* Compact Toast */
        .toast-container {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 1050;
        }

        .toast {
            background: var(--surface);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            min-width: 280px;
            backdrop-filter: blur(20px);
        }

        .toast-success {
            border-left: 3px solid var(--success);
        }

        .toast-error {
            border-left: 3px solid var(--danger);
        }

        .toast-header {
            background: var(--surface-hover);
            border-bottom: 1px solid var(--border-light);
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
            padding: 0.75rem 1rem;
        }

        .toast-body {
            padding: 0.75rem 1rem;
            font-weight: 500;
            font-size: 0.8rem;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            :root {
                --header-height: 220px;
            }

            body {
                font-size: 13px;
            }

            .header-content {
                padding: 0.75rem 1rem;
                flex-wrap: wrap;
            }

            .header-stats {
                width: 100%;
                justify-content: space-between;
                gap: 0.5rem;
            }

            .stat-item {
                padding: 0.375rem 0.5rem;
                min-width: 50px;
            }

            .stat-number {
                font-size: 1rem;
            }

            .stat-label {
                font-size: 0.55rem;
            }

            .filters-section {
                padding: 0.75rem 1rem;
                flex-direction: column;
                gap: 0.75rem;
            }

            .search-container {
                min-width: auto;
            }

            .applications-section {
                margin: 0.75rem;
                margin-top: 0.375rem;
            }

            .applications-header {
                padding: 0.75rem 1rem;
            }

            .applications-container {
                padding: 0.75rem;
                max-height: calc(100vh - var(--header-height) - 40px);
            }

            .application-card {
                padding: 0.875rem;
            }

            .application-details {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }

            .application-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .application-footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .modal-dialog {
                margin: 0.75rem;
            }

            .modal-header {
                padding: 1rem 1.25rem;
            }

            .section-content {
                padding: 1rem;
            }

            .detail-grid {
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }

            .status-form {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .scroll-to-top {
                bottom: 1rem;
                right: 1rem;
                width: 40px;
                height: 40px;
            }

            .photo-img {
                width: 40px;
                height: 40px;
            }

            .modal-photo {
                width: 80px;
                height: 80px;
            }

            .photo-badge {
                width: 24px;
                height: 24px;
                font-size: 0.625rem;
            }
        }

        @media (max-width: 480px) {
            body {
                font-size: 12px;
            }

            .applications-container {
                max-height: calc(100vh - var(--header-height) - 20px);
            }

            .application-card {
                padding: 0.75rem;
            }

            .infinite-loading {
                padding: 1.25rem;
            }

            .end-of-applications {
                padding: 1.25rem 0.875rem;
            }

            .modal-header {
                padding: 0.875rem 1rem;
            }

            .section-content {
                padding: 0.875rem;
            }

            .detail-card {
                padding: 0.75rem;
            }

            .status-update-content {
                padding: 1rem;
            }

            .toast {
                min-width: 250px;
            }

            .toast-header,
            .toast-body {
                padding: 0.625rem 0.875rem;
            }
        }

        @media (max-width: 360px) {
            .header-content {
                padding: 0.625rem 0.875rem;
            }

            .filters-section {
                padding: 0.625rem 0.875rem;
            }

            .applications-section {
                margin: 0.5rem;
            }

            .applications-container {
                padding: 0.625rem;
            }

            .application-card {
                padding: 0.625rem;
            }

            .photo-img {
                width: 36px;
                height: 36px;
            }

            .modal-photo {
                width: 70px;
                height: 70px;
            }
        }
    </style>
</head>
<body>
    <!-- Scroll Progress Indicator -->
    <div class="scroll-progress" id="scroll-progress"></div>

    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <div class="app-container">
        <!-- Compact Header Section -->
        <div class="header-section">
            <div class="header-content">
                <div class="header-left">
                    <a href="/v1/api/dashboard#admission" class="back-btn">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h1 class="header-title">
                        <i class="bi bi-file-earmark-text-fill"></i>
                        Applications
                        <span class="header-badge">Admissions</span>
                    </h1>
                </div>
                <div class="header-stats">
                    <div class="stat-item">
                        <span class="stat-number" id="total-applications">-</span>
                        <span class="stat-label">Total</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="under-review-applications">-</span>
                        <span class="stat-label">Under Review</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="pending-applications">-</span>
                        <span class="stat-label">Pending</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="approved-applications">-</span>
                        <span class="stat-label">Approved</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" id="today-applications">-</span>
                        <span class="stat-label">Today</span>
                    </div>
                </div>
            </div>
            <div class="filters-section">
                <div class="search-container">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="Search by name, email, ref no..." id="search-input">
                </div>
                <select class="filter-select" id="status-filter">
                    <option value="">All Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Under Review">Under Review</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
                <select class="filter-select" id="program-filter">
                    <option value="">All Programs</option>
                    <option value="BCA">BCA</option>
                    <option value="MCA">MCA</option>
                    <option value="MBA">MBA</option>
                    <option value="BTech">BTech</option>
                    <option value="CSE">CSE</option>
                    <option value="ECE">ECE</option>
                    <option value="EEE">EEE</option>
                    <option value="Mechanical">Mechanical</option>
                    <option value="Civil">Civil</option>
                </select>
            </div>
        </div>

        <!-- Compact Applications Section -->
        <div class="applications-section">
            <div class="applications-header">
                <h2 class="applications-title">
                    <i class="bi bi-list-ul"></i>
                    Recent Applications
                </h2>
            </div>
            <div class="applications-container" id="applications-container">
                <div id="application-list" class="application-list">
                    <!-- Applications will be loaded here via JavaScript -->
                </div>
                
                <!-- Infinite Loading Indicator -->
                <div class="infinite-loading hidden" id="infinite-loading">
                    <div class="loading-spinner"></div>
                    <span>Loading more applications...</span>
                </div>
                
                <!-- End of Applications Indicator -->
                <div class="end-of-applications hidden" id="end-of-applications">
                    <i class="bi bi-check-circle-fill"></i>
                    <p>You've reached the end of all applications</p>
                </div>
            </div>
        </div>

        <!-- Scroll to Top Button -->
        <button class="scroll-to-top" id="scroll-to-top" title="Scroll to top">
            <i class="bi bi-arrow-up"></i>
        </button>
    </div>

    <!-- Compact Application Details Modal -->
    <div class="modal fade" id="applicationModal" tabindex="-1" aria-labelledby="applicationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="applicationModalLabel">
                        <i class="bi bi-person-badge-fill"></i>
                        Application Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modal-body-content">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // App state
            let currentPage = 1;
            let currentSearch = '';
            let currentStatusFilter = '';
            let currentProgramFilter = '';
            let isLoading = false;
            let hasMoreApplications = true;
            let allApplications = [];
            let loadedApplicationIds = new Set();
            let currentApplicationData = null;

            // DOM elements
            const applicationList = document.getElementById('application-list');
            const applicationsContainer = document.getElementById('applications-container');
            const searchInput = document.getElementById('search-input');
            const statusFilter = document.getElementById('status-filter');
            const programFilter = document.getElementById('program-filter');
            const totalApplicationsEl = document.getElementById('total-applications');
            const underReviewApplicationsEl = document.getElementById('under-review-applications');
            const pendingApplicationsEl = document.getElementById('pending-applications');
            const approvedApplicationsEl = document.getElementById('approved-applications');
            const todayApplicationsEl = document.getElementById('today-applications');
            const infiniteLoading = document.getElementById('infinite-loading');
            const endOfApplications = document.getElementById('end-of-applications');
            const scrollToTopBtn = document.getElementById('scroll-to-top');
            const scrollProgress = document.getElementById('scroll-progress');
            const toastContainer = document.getElementById('toast-container');

            // Modal elements
            const applicationModal = new bootstrap.Modal(document.getElementById('applicationModal'));
            const modalBodyContent = document.getElementById('modal-body-content');

            // API endpoints
            const API_BASE = '/v1/api';
            const ENDPOINTS = {
                applications: `${API_BASE}/getAdmissionApplications`,
                stats: `${API_BASE}/admissionApplications/stats`,
                applicationDetails: `${API_BASE}/admissionApplication`,
                updateStatus: `${API_BASE}/admissionApplication`
            };

            // Utility functions
            function formatDate(dateString) {
                if (!dateString) return '';
                try {
                    const date = new Date(dateString);
                    if (isNaN(date.getTime())) return dateString;
                    
                    return date.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                    });
                } catch (e) {
                    return dateString;
                }
            }

            function formatTime(dateString) {
                if (!dateString) return '';
                try {
                    const date = new Date(dateString);
                    if (isNaN(date.getTime())) return dateString;
                    
                    return date.toLocaleTimeString('en-US', {
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                    });
                } catch (e) {
                    return dateString;
                }
            }

            function getStatusClass(status) {
                switch (status?.toLowerCase()) {
                    case 'approved': return 'status-approved';
                    case 'rejected': return 'status-rejected';
                    case 'under review': return 'status-under-review';
                    default: return 'status-pending';
                }
            }

            function updateScrollProgress() {
                const container = applicationsContainer;
                const scrollTop = container.scrollTop;
                const scrollHeight = container.scrollHeight - container.clientHeight;
                const scrollPercent = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
                scrollProgress.style.width = Math.min(scrollPercent, 100) + '%';
            }

            // Toast notification function
            function showToast(message, type = 'success') {
                const toastId = 'toast-' + Date.now();
                const toastHTML = `
                    <div class="toast toast-${type}" role="alert" aria-live="assertive" aria-atomic="true" id="${toastId}">
                        <div class="toast-header">
                            <i class="bi bi-${type === 'success' ? 'check-circle-fill text-success' : 'exclamation-triangle-fill text-danger'} me-2"></i>
                            <strong class="me-auto">${type === 'success' ? 'Success' : 'Error'}</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                `;
                
                toastContainer.insertAdjacentHTML('beforeend', toastHTML);
                const toastElement = document.getElementById(toastId);
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                // Remove toast element after it's hidden
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }

            // Show skeleton loading
            function showSkeletonLoading() {
                const skeletonHTML = `
                    <div class="skeleton-container">
                        ${Array(6).fill().map(() => `
                            <div class="skeleton-application">
                                <div class="skeleton-photo"></div>
                                <div class="skeleton-content">
                                    <div class="skeleton-line title"></div>
                                    <div class="skeleton-line subtitle"></div>
                                    <div class="skeleton-line content"></div>
                                    <div class="skeleton-line content-short"></div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
                applicationList.innerHTML = skeletonHTML;
            }

            // Show loading state
            function showLoading() {
                applicationList.innerHTML = `
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <span>Loading applications...</span>
                    </div>
                `;
            }

            // Show empty state
            function showEmptyState(message = 'No applications found') {
                applicationList.innerHTML = `
                    <div class="empty-state fade-in">
                        <i class="bi bi-file-earmark-x"></i>
                        <h3>No Applications</h3>
                        <p>${message}</p>
                    </div>
                `;
                hideInfiniteScrollElements();
            }

            // Hide infinite scroll elements
            function hideInfiniteScrollElements() {
                infiniteLoading.classList.add('hidden');
                endOfApplications.classList.add('hidden');
            }

            // Show infinite loading
            function showInfiniteLoading() {
                infiniteLoading.classList.remove('hidden');
                endOfApplications.classList.add('hidden');
            }

            // Show end of applications
            function showEndOfApplications() {
                infiniteLoading.classList.add('hidden');
                endOfApplications.classList.remove('hidden');
            }

            // Fetch and update stats
            async function fetchStats() {
                try {
                    const response = await fetch(ENDPOINTS.stats);
                    if (!response.ok) throw new Error('Failed to fetch stats');
                    
                    const stats = await response.json();
                    updateStats(stats.data || stats);
                } catch (error) {
                    console.error('Error fetching stats:', error);
                    updateStats({ totalCount: 0, underReviewCount: 0, pendingCount: 0, approvedCount: 0, todayCount: 0 });
                }
            }

            // Update statistics display
            function updateStats(stats) {
                totalApplicationsEl.textContent = stats.totalCount || 0;
                underReviewApplicationsEl.textContent = stats.underReviewCount || 0;
                pendingApplicationsEl.textContent = stats.pendingCount || 0;
                approvedApplicationsEl.textContent = stats.approvedCount || 0;
                todayApplicationsEl.textContent = stats.todayCount || 0;
            }

            // Fetch applications from API
            async function fetchApplications(page = 1, search = '', status = '', program = '', append = false) {
                if (isLoading) {
                    console.log('Already loading, skipping request');
                    return;
                }
                
                console.log(`🚀 Fetching applications - Page: ${page}, Search: "${search}", Status: "${status}", Program: "${program}", Append: ${append}`);
                
                isLoading = true;
                
                if (!append) {
                    showSkeletonLoading();
                    hideInfiniteScrollElements();
                    allApplications = [];
                    loadedApplicationIds.clear();
                } else {
                    showInfiniteLoading();
                }

                try {
                    const params = new URLSearchParams({
                        page: page.toString(),
                        limit: '10'
                    });

                    if (search.trim()) params.append('search', search.trim());
                    if (status.trim()) params.append('status', status.trim());
                    if (program.trim()) params.append('program', program.trim());

                    const url = `${ENDPOINTS.applications}?${params}`;
                    console.log('📡 API Request:', url);

                    const response = await fetch(url);
                    if (!response.ok) throw new Error(`HTTP ${response.status}: Failed to fetch applications`);

                    const data = await response.json();
                    console.log('📦 API Response:', data);
                    
                    if (data.success) {
                        const applications = data.data.applications || [];
                        console.log(`📨 Received ${applications.length} applications`);
                        
                        // Filter out duplicate applications
                        const newApplications = applications.filter(app => !loadedApplicationIds.has(app._id));
                        console.log(`✨ New applications after deduplication: ${newApplications.length}`);
                        
                        // Add new application IDs to the set
                        newApplications.forEach(app => loadedApplicationIds.add(app._id));
                        
                        if (append) {
                            allApplications = [...allApplications, ...newApplications];
                            appendApplications(newApplications);
                        } else {
                            allApplications = newApplications;
                            renderApplications(newApplications);
                        }

                        // Update pagination state
                        const pagination = data.data.pagination;
                        hasMoreApplications = pagination && pagination.hasNext;
                        currentPage = page;
                        currentSearch = search;
                        currentStatusFilter = status;
                        currentProgramFilter = program;

                        console.log(`📄 Pagination - Current: ${currentPage}, HasNext: ${hasMoreApplications}`);

                        // Handle end of applications
                        if (!hasMoreApplications && allApplications.length > 0) {
                            showEndOfApplications();
                            console.log('🏁 Reached end of applications');
                        } else {
                            hideInfiniteScrollElements();
                        }

                    } else {
                        throw new Error(data.message || 'Failed to fetch applications');
                    }
                } catch (error) {
                    console.error('❌ Error fetching applications:', error);
                    if (!append) {
                        showEmptyState('Error loading applications. Please try again.');
                    } else {
                        hideInfiniteScrollElements();
                    }
                } finally {
                    isLoading = false;
                    console.log('✅ Fetch complete, isLoading set to false');
                }
            }

            // Render applications (replace all)
            function renderApplications(applications) {
                if (!applications || applications.length === 0) {
                    const filters = [];
                    if (currentSearch) filters.push(`"${currentSearch}"`);
                    if (currentStatusFilter) filters.push(`status: ${currentStatusFilter}`);
                    if (currentProgramFilter) filters.push(`program: ${currentProgramFilter}`);
                    
                    const filterText = filters.length > 0 ? ` for ${filters.join(', ')}` : '';
                    showEmptyState(`No applications found${filterText}`);
                    return;
                }

                const applicationsHTML = applications.map(application => createApplicationHTML(application)).join('');
                applicationList.innerHTML = applicationsHTML;
                addApplicationClickHandlers();
            }

            // Append applications (for infinite scroll)
            function appendApplications(applications) {
                if (!applications || applications.length === 0) return;

                const applicationsHTML = applications.map(application => createApplicationHTML(application)).join('');
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = applicationsHTML;
                
                // Add fade-in animation to new applications
                const newCards = tempDiv.querySelectorAll('.application-card');
                newCards.forEach((card, index) => {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(15px)';
                    setTimeout(() => {
                        card.style.transition = 'all 0.4s ease';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    }, index * 80);
                });
                
                while (tempDiv.firstChild) {
                    applicationList.appendChild(tempDiv.firstChild);
                }
                
                addApplicationClickHandlers();
            }

