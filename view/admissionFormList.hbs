            // Add click handlers to application cards
            function addApplicationClickHandlers() {
                const applicationCards = applicationList.querySelectorAll('.application-card:not([data-click-handler])');
                applicationCards.forEach(card => {
                    card.setAttribute('data-click-handler', 'true');
                    card.addEventListener('click', function() {
                        const applicationId = this.dataset.applicationId;
                        showApplicationDetails(applicationId);
                    });
                });
            }

            // Show application details in modal
            async function showApplicationDetails(applicationId) {
                try {
                    // Find application in current data first
                    let application = allApplications.find(app => app._id === applicationId);
                    
                    if (!application) {
                        // If not found, fetch from API
                        const response = await fetch(`${ENDPOINTS.applicationDetails}/${applicationId}`);
                        if (!response.ok) throw new Error('Failed to fetch application details');
                        
                        const data = await response.json();
                        if (data.success) {
                            application = data.data.application || data.data;
                        } else {
                            throw new Error(data.message || 'Failed to fetch application details');
                        }
                    }

                    if (application) {
                        currentApplicationData = application;
                        modalBodyContent.innerHTML = createModalContent(application);
                        applicationModal.show();
                    }
                } catch (error) {
                    console.error('Error fetching application details:', error);
                    showToast('Failed to load application details', 'error');
                }
            }

            // Update application status
            window.updateApplicationStatus = async function(applicationId) {
                const statusSelect = document.getElementById('status-select');
                const remarksInput = document.getElementById('remarks-input');
                const updateBtn = document.getElementById('update-status-btn');

                if (!statusSelect || !remarksInput || !updateBtn) return;

                const newStatus = statusSelect.value;
                const remarks = remarksInput.value.trim();

                if (!newStatus) {
                    showToast('Please select a status', 'error');
                    return;
                }

                // Check if status actually changed
                if (currentApplicationData && currentApplicationData.status === newStatus) {
                    showToast('Status is already set to ' + newStatus, 'error');
                    return;
                }

                updateBtn.disabled = true;
                updateBtn.innerHTML = '<div class="loading-spinner" style="width: 14px; height: 14px;"></div> Updating...';

                try {
                    const response = await fetch(`${ENDPOINTS.updateStatus}/${applicationId}/status`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            status: newStatus,
                            remarks: remarks
                        })
                    });

                    if (!response.ok) throw new Error('Failed to update status');

                    const data = await response.json();
                    
                    if (data.success) {
                        // Update the application in local data
                        const appIndex = allApplications.findIndex(app => app._id === applicationId);
                        if (appIndex !== -1) {
                            allApplications[appIndex].status = newStatus;
                            allApplications[appIndex].updatedAt = new Date().toISOString();
                        }

                        // Update current application data
                        if (currentApplicationData) {
                            currentApplicationData.status = newStatus;
                            currentApplicationData.updatedAt = new Date().toISOString();
                        }

                        // Update the card in the list
                        const applicationCard = document.querySelector(`[data-application-id="${applicationId}"]`);
                        if (applicationCard) {
                            const statusBadge = applicationCard.querySelector('.status-badge');
                            if (statusBadge) {
                                statusBadge.className = `status-badge ${getStatusClass(newStatus)}`;
                                statusBadge.innerHTML = `<i class="bi bi-circle-fill"></i> ${newStatus}`;
                            }
                        }

                        // Close modal and show success message
                        applicationModal.hide();
                        showToast(`Application status updated to ${newStatus}`, 'success');

                        // Refresh stats
                        fetchStats();

                    } else {
                        throw new Error(data.message || 'Failed to update status');
                    }
                } catch (error) {
                    console.error('Error updating status:', error);
                    showToast('Failed to update application status', 'error');
                } finally {
                    updateBtn.disabled = false;
                    updateBtn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Update Status';
                }
            };

            // Enhanced infinite scroll handler
            function handleScroll() {
                const container = applicationsContainer;
                const scrollTop = container.scrollTop;
                const scrollHeight = container.scrollHeight;
                const clientHeight = container.clientHeight;

                // Update scroll progress
                updateScrollProgress();

                // Show/hide scroll to top button
                if (scrollTop > 200) {
                    scrollToTopBtn.classList.add('visible');
                } else {
                    scrollToTopBtn.classList.remove('visible');
                }

                // Calculate distance from bottom
                const distanceFromBottom = scrollHeight - (scrollTop + clientHeight);
                const threshold = 200;
                
                console.log(`📏 Scroll Check - Distance from bottom: ${Math.round(distanceFromBottom)}px, Threshold: ${threshold}px`);
                
                // Check if we should load more applications
                if (distanceFromBottom <= threshold) {
                    if (hasMoreApplications && !isLoading && allApplications.length > 0) {
                        console.log('🔄 Triggering infinite scroll load');
                        fetchApplications(currentPage + 1, currentSearch, currentStatusFilter, currentProgramFilter, true);
                    } else {
                        console.log(`⏸️ Not loading - HasMore: ${hasMoreApplications}, Loading: ${isLoading}, Applications: ${allApplications.length}`);
                    }
                }
            }

            // Scroll to top functionality
            scrollToTopBtn.addEventListener('click', function() {
                applicationsContainer.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            // Search functionality with debounce
            let searchTimeout;
            searchInput.addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    const searchTerm = e.target.value.trim();
                    console.log('🔍 Searching for:', searchTerm);
                    resetAndFetch();
                }, 500);
            });

            // Status filter functionality
            statusFilter.addEventListener('change', function(e) {
                console.log('📊 Status filter changed:', e.target.value);
                resetAndFetch();
            });

            // Program filter functionality
            programFilter.addEventListener('change', function(e) {
                console.log('🎓 Program filter changed:', e.target.value);
                resetAndFetch();
            });

            // Reset state and fetch with current filters
            function resetAndFetch() {
                currentPage = 1;
                hasMoreApplications = true;
                allApplications = [];
                loadedApplicationIds.clear();
                
                fetchApplications(
                    1, 
                    searchInput.value.trim(), 
                    statusFilter.value, 
                    programFilter.value, 
                    false
                );
            }

            // Enhanced scroll event listener
            applicationsContainer.addEventListener('scroll', handleScroll);

            // Keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Ctrl/Cmd + F to focus search
                if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                    e.preventDefault();
                    searchInput.focus();
                }
                
                // Escape to clear search and filters
                if (e.key === 'Escape' && (document.activeElement === searchInput || document.activeElement === statusFilter || document.activeElement === programFilter)) {
                    searchInput.value = '';
                    statusFilter.value = '';
                    programFilter.value = '';
                    resetAndFetch();
                }
            });

            // Initialize app
            function init() {
                console.log('🚀 Initializing Compact Admission Applications App...');
                
                // Load initial data
                Promise.all([
                    fetchStats(),
                    fetchApplications(1)
                ]).then(() => {
                    console.log('✅ App initialized successfully');
                }).catch(error => {
                    console.error('❌ Error initializing app:', error);
                });

                // Auto-refresh stats every 30 seconds
                setInterval(fetchStats, 30000);

                // Auto-refresh applications every 2 minutes (only if at top and no filters)
                setInterval(() => {
                    if (applicationsContainer.scrollTop < 100 && !currentSearch && !currentStatusFilter && !currentProgramFilter) {
                        console.log('🔄 Auto-refreshing applications...');
                        resetAndFetch();
                    }
                }, 120000);
            }

            // Handle visibility change (refresh when tab becomes visible)
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden && applicationsContainer.scrollTop < 100 && !currentSearch && !currentStatusFilter && !currentProgramFilter) {
                    fetchStats();
                }
            });

            // Start the app
            init();
        });
    </script>
</body>
</html>